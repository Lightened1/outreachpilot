# Copy to .env and adjust. Every value here has a safe default; nothing is required to run the demo.
# Never commit your .env file.

# --- App -------------------------------------------------------------------------------------
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                   # true = one JSON object per line (for log shippers)
DATABASE_URL=sqlite+aiosqlite:///./data/outreachpilot.db
ARTIFACTS_DIR=artifacts          # screenshots are written here
BROWSER_SESSION_DIR=.sessions    # saved browser login state (git-ignored)

# --- Security ------------------------------------------------------------------------------
# Required when ENVIRONMENT=production. Clients send it as the X-API-Key header; the console asks for it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Extra browser origins allowed to call the API (comma-separated). The built-in console needs none.
CORS_ORIGINS=

# --- LLM -------------------------------------------------------------------------------------
# auto = use OpenAI-compatible API when OPENAI_API_KEY is set, otherwise the offline mock generator
LLM_MODE=auto                    # auto | mock | openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint (OpenRouter, Ollama, vLLM, ...)
OPENAI_MODEL=gpt-4o-mini
OPENAI_JSON_MODE=true            # set false if your provider does not support response_format=json_object
LLM_TIMEOUT_S=30
LLM_REQUESTS_PER_MINUTE=30
MESSAGE_MAX_WORDS=130
MESSAGE_VALIDATION_ATTEMPTS=3

# --- Sender profile (the only facts about "us" the model may use) ----------------------------
SENDER_NAME=Alex Morgan
SENDER_ROLE=Solutions Engineer
SENDER_COMPANY=Northwind Analytics
SENDER_VALUE_PROP=we help operations teams automate repetitive reporting work

# --- Browser automation ----------------------------------------------------------------------
DEMO_PORTAL_URL=http://127.0.0.1:8010
DEMO_USERNAME=demo
DEMO_PASSWORD=demo-password      # local demo portal only
ALLOWED_AUTOMATION_HOSTS=127.0.0.1,localhost,demo
RESPECT_ROBOTS_TXT=true
BROWSER_HEADLESS=true
# Leave empty for bundled Chromium, or e.g. chrome to use an installed Google Chrome
BROWSER_CHANNEL=
BROWSER_SLOW_MO_MS=0             # e.g. 400 when screen recording a headed run
BROWSER_TIMEOUT_MS=8000          # element waits
NAVIGATION_TIMEOUT_MS=15000
BROWSER_MAX_PAGES=2              # concurrent pages
PERSIST_BROWSER_SESSION=true
BROWSER_TRACE_ON_FAILURE=true    # keep a Playwright trace (artifacts/traces/*.zip) for failed browser jobs
NAVIGATIONS_PER_MINUTE=60        # per host
NAVIGATION_BURST=5

# --- Background tasks ------------------------------------------------------------------------
TASK_MAX_CONCURRENCY=2
TASK_MAX_ATTEMPTS=3
TASK_TIMEOUT_S=120
RETRY_BASE_DELAY_S=1
RETRY_MAX_DELAY_S=20
